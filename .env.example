# Complaint-Tantra environment template.
# Copy to .env and fill real values. Never commit .env.

# --- Database ---
# Supabase direct connection. If your project only exposes the pooler, use:
# postgresql+asyncpg://postgres.<project-ref>:PASSWORD@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# --- Backend ---
JWT_SECRET=change-me-long-random-string
JWT_EXPIRY_MINUTES=720
CORS_ORIGINS=http://localhost:3000
STUCK_DAYS=7

# --- AI / LLM (LiteLLM provider-agnostic) ---
# none | ollama | openai-free | gemini | anthropic
LLM_PROVIDER=none
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_DEFAULT_MODEL=llama3.2:3b
LLM_TIMEOUT_MS=30000
PROMPT_VERSION=v1

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OPENAI_FREE_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-1.5-flash
ANTHROPIC_MODEL=claude-3-haiku-20240307

# --- Embeddings / sentiment ---
EMBEDDING_MODEL=BAAI/bge-m3
# auto = bge-m3 when installed, hash when offline; hash = never load the model
EMBEDDING_BACKEND=auto
EMBEDDING_DEVICE=
SENTIMENT_MODEL=cardiffnlp/twitter-xlm-roberta-base-sentiment
SENTIMENT_BACKEND=auto

# --- Web intelligence ---
# 1 enables live search even without a paid key (GDELT / Google News RSS)
WEB_INTEL_LIVE=0
TAVILY_API_KEY=
BRAVE_API_KEY=

# --- Optional LLM tracing (Langfuse) ---
# Leave keys blank to disable tracing completely.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Prod-only (Docker Compose, unused in demo) ---
# MINIO_ENDPOINT=http://minio:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# REDIS_URL=redis://redis:6379/0
